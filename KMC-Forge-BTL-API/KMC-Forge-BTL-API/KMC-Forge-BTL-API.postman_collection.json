	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Pre-request script to set up common headers",
					"pm.request.headers.add({",
					"    key: 'User-Agent',",
					"    value: 'KMC-Forge-BTL-API-Postman'",
					"});"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Test script to validate responses",
					"pm.test(\"Status code is 200 or 201\", function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
					"});",
					"",
					"pm.test(\"Response has required fields\", function () {",
					"    const responseJson = pm.response.json();",
					"    ",
					"    if (pm.request.url.path.includes('upload2')) {",
					"        pm.expect(responseJson).to.have.property('portfolioId');",
					"        pm.expect(responseJson).to.have.property('status');",
					"        pm.expect(responseJson).to.have.property('summary');",
					"    }",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5001",
			"type": "string",
			"description": "Base URL for the KMC Forge BTL API"
		}
	]
